# Copy to .env or export before running (example values).
SERVICE_NAME=cobo_iam_services
ENV=development
LOG_LEVEL=info

# API
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# Worker
WORKER_TICK_INTERVAL=5s

# MySQL (optional for P0.1 bootstrap; required for /readyz = ready).
# When set, API + worker use table `outbox_events` for durable outbox (MySQL 8+ for SKIP LOCKED).
# Use parseTime=true and loc=UTC for TIMESTAMP columns.
# MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/cobo_iam?parseTime=true&loc=UTC&tls=false

# Redis (optional P2.2): shared effective-access projection cache for API instances.
# If REDIS_ADDR is set but Redis is unreachable at startup, API falls back to in-memory cache.
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# EFFECTIVE_ACCESS_CACHE_TTL=5m

# Access token migration mode:
# - opaque: current stable behavior
# - dual: issue JWT, verify JWT first then opaque fallback (migration)
# - jwt: JWT only
ACCESS_TOKEN_MODE=opaque
ACCESS_TOKEN_TTL=15m

# JWT settings (used for jwt/dual modes)
JWT_ISSUER=cobo_iam_services
JWT_AUDIENCE=cobo_clients
JWT_ALG=EdDSA
# JWT_SIGNING_PRIVATE_KEY_PEM=
# JWT_VERIFY_PUBLIC_KEYS_JSON=
JWT_CLOCK_SKEW_SEC=60

# Web base URL for email action links (reset password, invite, OTP footer).
# Local Vite / docker-compose.dev.yml:
PUBLIC_WEB_BASE_URL=http://localhost:5173
# Dev server deploy (88.216.208.0 — docker-compose.artifacts.yml):
# PUBLIC_WEB_BASE_URL=http://88.216.208.0:3000
# PUBLIC_API_BASE_URL=http://88.216.208.0:8080
# Footer in registration OTP email (Website line uses PUBLIC_WEB_BASE_URL)
# SUPPORT_EMAIL=support@cobo.vn

# Login password transport encryption (RSA-OAEP-256). Required when the web client encrypts passwords before POST /api/v1/auth/login.
# Dev: use the committed key file (docker-compose sets LOGIN_PASSWORD_RSA_PRIVATE_KEY_PEM_FILE automatically).
# LOGIN_PASSWORD_RSA_PRIVATE_KEY_PEM_FILE=configs/login_password_rsa_dev.pem
# LOGIN_PASSWORD_RSA_KEY_ID=dev
# Or inline PEM (escape newlines as \n in .env if needed):
# LOGIN_PASSWORD_RSA_PRIVATE_KEY_PEM=
# Regenerate dev key: go run ./cmd/genloginrsakey

# SMTP (worker): if SMTP_HOST is empty, worker logs email payload instead of sending.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@cobo.vn

# ── Customize-Workflow feature flags ─────────────────────────────────────────
# Enable progressively; all default to false/off so existing behaviour is unchanged.
# WORKFLOW_GROUPS_ENABLED=false          # expose groups[] on effective workflow response
# WORKFLOW_DRAFT_ETAG_MODE=off           # optimistic locking: off | warn | enforce
# WORKFLOW_SNAPSHOT_ENABLED=false        # freeze workflow JSON into workflow_instances (P0 nghiệm thu: true)
# WORKFLOW_TIMELINE_ENABLED=false        # compute step timelines + seed milestone rows
# WORKFLOW_REMINDERS_ENABLED=false       # dispatch reminder emails from seeded milestones
# WORKFLOW_VERSIONING_ENABLED=false      # CMS global workflow versioning lifecycle (publish≠activate); registers .../workflow/configuration
# WORKFLOW_ADHOC_ENABLED=false           # enable ad-hoc proposal state machine (defaults true when ENV=development)
# WORKFLOW_ADHOC_AUTOAPPROVE_ENABLED=false  # skip focal step (single-stage admin approval)
# ADHOC_EMAIL_OUTBOX_ENABLED=false       # Batch 2 cutover: route AdhocProposalNotifier through the durable email pipeline
# ADHOC_EMAIL_SHADOW_RECIPIENT=          # sink address for durable-path shadow dispatches during EMAIL_SHADOW_MODE (required when EMAIL_SHADOW_MODE=true)
# PERIODIC_SEEDING_ENABLED=false         # worker seeds + materializes periodic/custom records (P0 dev: true)
# TEMPLATE_APPLICABILITY_STRICT_FILTER=false  # when false, global templates without rules still pass Portal filter (grace)
# DEADLINE_ENGINE_V2=false                   # unified deadline = T0 + N engine (Batch 2+); keep false until smoke Batch 7

# Vnstock read-only MySQL (CMS listed companies reference; separate from MYSQL_DSN / cobo_iam).
# From API container use host mysql:3306, not 127.0.0.1. Do not commit real passwords.
# VNSTOCK_MARKET_ENABLED=false
# VNSTOCK_MYSQL_DSN=vnstock:YOUR_PASSWORD@tcp(mysql:3306)/vnstock?parseTime=true&loc=UTC&tls=false

# CMS media signed upload (platform/cms/media). Do not use for user avatars.
# CMS_MEDIA_UPLOAD_SIGNING_SECRET=change-me-in-production
# CMS_MEDIA_UPLOAD_URL_TTL=10m
# CMS_MEDIA_STORAGE_DIR=./var/cms-media

# User avatar (/me/avatar). Uses a dedicated signing secret and storage under user-avatars/.
# On dev server, bind-mount CMS_MEDIA_STORAGE_DIR (or USER_AVATAR_STORAGE_DIR) for persistence
# across container recreate — see docs/ai-cache/user-avatar-batch0-verification.md.
# USER_AVATAR_UPLOAD_SIGNING_SECRET=change-me-in-production
# USER_AVATAR_MAX_BYTES=2097152
# USER_AVATAR_ALLOWED_TYPES=image/png,image/jpeg,image/webp
# USER_AVATAR_STORAGE_DIR=
# USER_AVATAR_SIGNED_URL_TTL=15m
# USER_AVATAR_SIGNED_URL_TTL_SECONDS=900

# P0 workflow/deadline dev (contract v1.1 AC-8, WF-A):
# WORKFLOW_SNAPSHOT_ENABLED=true
# WORKFLOW_ADHOC_ENABLED=true
# PERIODIC_SEEDING_ENABLED=true
