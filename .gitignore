# Local secrets — never commit
.env
.env.*
!.env.example
deploy-dev.local.env

# Reproducible local/build outputs.
/bin/
/api
/worker
/*.exe
/deploy-artifacts/backend/bin/
/deploy-artifacts/web/dist/

# QA evidence generated by browser/API smoke runs. Keep summaries and contracts;
# store screenshots/traces/large captures outside Git.
/docs/ai-cache/**/screenshots/
/docs/ai-cache/**/*.png
/docs/ai-cache/**/*.jpg
/docs/ai-cache/**/*.jpeg
/docs/ai-cache/**/*.webp
/docs/ai-cache/**/*.har
/docs/ai-cache/**/trace.zip
/docs/ai-cache/**/*.mp4
