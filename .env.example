# Copy to `.env` in this directory before `docker compose -f docker-compose.dev.yml up`.
# Docker Compose loads `.env` for variable substitution; `.env` is gitignored.

# --- Optional Gmail / real SMTP ---
# Omit these (or comment out) to keep using Mailpit in dev (see http://localhost:8025).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=paste_google_app_password_16_chars_no_spaces
SMTP_FROM=your.address@gmail.com

# --- CMS invite: default roles.role_code when invite omits role_id / role_code (MySQL resolves per company) ---
# INVITE_DEFAULT_ROLE_CODE=user_thuong

# Set to true to disable POST /api/v1/auth/register (public sign-up).
# REGISTRATION_DISABLED=true

# TTL for email verification OTP (register + resend); default 15m.
# EMAIL_VERIFICATION_OTP_TTL=15m
