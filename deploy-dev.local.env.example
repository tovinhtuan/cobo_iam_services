# Sao chép thành deploy-dev.local.env (file đó không commit — đã có trong .gitignore).
# deploy-dev.ps1 đọc các biến sau khi khởi chạy.

DEV_HOST=88.216.208.0
DEV_PORT=21239
DEV_USER=root
DEV_PATH=/root/cobo_project

# (Tùy chọn) SSH key — uu tien hon password
# DEV_SSH_IDENTITY_FILE=C:\Users\you\.ssh\id_rsa

# (Tuy chon) Password — Windows dung PuTTY plink/pscp; file nay da gitignore
# DEV_SSH_PASSWORD=your-dev-ssh-password
